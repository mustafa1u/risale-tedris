---
import { NAV_ITEMS } from "@/config/navigation";
import { groupBooksByLanguage } from "@/config/bookGroups";
import { SEARCH_ENABLED } from "@/config/features.js";
import { ACTIVE_THEME } from "@/config/themes";
import { librarySummary } from "@/data/library-summary.generated";
import { DEFAULT_LOCALE, getUi, ui, type Locale } from "@/i18n";
import { localizedPath } from "@/i18n/routing";
import rtLogo from "@/assets/site/rt.png";
import "@/styles/global.css";
import type { LibrarySearchBookReference } from "@/types/library";

type GlobalSearchConfig = {
  manifestUrl: string;
  books: LibrarySearchBookReference[];
};

type Props = {
  title: string;
  description?: string;
  locale?: Locale;
  globalSearch?: GlobalSearchConfig;
};

const { title, locale = DEFAULT_LOCALE, globalSearch } = Astro.props as Props;
const text = getUi(locale);
const resolvedGlobalSearch = globalSearch ?? (SEARCH_ENABLED
  ? {
      manifestUrl: librarySummary.search.manifestUrl,
      books: librarySummary.books.map((book) => book.search)
    }
  : undefined);
const description = Astro.props.description ?? text.layout.defaultDescription;
const siteTitle = text.layout.siteTitle;
const pageTitle = `${title} | ${siteTitle}`;
const currentPath = Astro.url.pathname;
const alternateLocale: Locale = locale === DEFAULT_LOCALE ? "en" : DEFAULT_LOCALE;
const alternateLocaleHref = localizedPath(alternateLocale, currentPath);
const alternateLocaleLabel = ui[alternateLocale].localeName;
const themeRuntimeConfig = {
  defaultTheme: ACTIVE_THEME,
  legacyDefaultTheme: ACTIVE_THEME,
  themePreferenceMigration: "risale-tedris-fixed-v1",
  themes: [ACTIVE_THEME],
  navLabels: {},
  currentHeadings: {}
};
const navLabels = {
  books: text.nav.books,
  howItWorks: text.nav.howItWorks,
  lessonFlow: text.nav.lessonFlow
};
const navigationItems = NAV_ITEMS.map((item) => {
  const href = localizedPath(locale, item.path);

  return {
    ...item,
    href,
    isCurrent: currentPath === href || currentPath.startsWith(href)
  };
});
const bookNavigationSections = groupBooksByLanguage(librarySummary.books, locale);
const compactNavigationItems = navigationItems.map((item) => ({
  ...item,
  label: navLabels[item.id]
}));
---

<!doctype html>
<html lang={locale} data-theme={ACTIVE_THEME}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.ico?v=0.3.0" type="image/x-icon" />
    <script is:inline>
      (() => {
        const preferenceKey = "rissor-ag-locale";
        const currentLocale = document.documentElement.lang === "en" ? "en" : "tr";
        const readPreference = () => {
          try {
            const value = localStorage.getItem(preferenceKey);
            return value === "en" || value === "tr" ? value : null;
          } catch {
            return null;
          }
        };
        const writePreference = (locale) => {
          try {
            localStorage.setItem(preferenceKey, locale);
          } catch {
            // Locale persistence is optional when browser storage is unavailable.
          }
        };
        const preferredLocale = readPreference();

        if (preferredLocale && preferredLocale !== currentLocale) {
          const path = window.location.pathname;
          const unlocalizedPath = path === "/en" ? "/" : path.startsWith("/en/") ? path.slice(3) : path;
          const localizedPath = preferredLocale === "en"
            ? (unlocalizedPath === "/" ? "/en/" : `/en${unlocalizedPath}`)
            : unlocalizedPath;
          window.location.replace(`${localizedPath}${window.location.search}${window.location.hash}`);
          return;
        }

        document.addEventListener("click", (event) => {
          const link = event.target instanceof Element
            ? event.target.closest("[data-locale-preference]")
            : null;
          const locale = link?.getAttribute("data-locale-preference");
          if (locale === "en" || locale === "tr") {
            writePreference(locale);
          }
        });
      })();
    </script>
    <script is:inline id="rissor-theme-config" type="application/json" set:html={JSON.stringify(themeRuntimeConfig)}></script>
    <script is:inline>
      (() => {
        const storageKey = "rissor-ag-theme";
        const explicitPreferenceKey = "rissor-ag-theme-explicit";
        const migrationKey = "rissor-ag-theme-migration";
        const configElement = document.getElementById("rissor-theme-config");
        const config = configElement ? JSON.parse(configElement.textContent || "{}") : {};
        const themes = Array.isArray(config.themes) ? config.themes : [];
        const defaultTheme = themes.includes(config.defaultTheme) ? config.defaultTheme : themes[0];
        const legacyDefaultTheme = themes.includes(config.legacyDefaultTheme) ? config.legacyDefaultTheme : null;
        const preferenceMigration = typeof config.themePreferenceMigration === "string"
          ? config.themePreferenceMigration
          : "";
        const isValidTheme = (theme) => themes.includes(theme);
        const readStorage = (key) => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };
        const writeStorage = (key, value) => {
          try {
            localStorage.setItem(key, value);
          } catch {
            // Theme persistence is optional for local/dev previews.
          }
        };
        const storedTheme = readStorage(storageKey);
        const storedMigration = readStorage(migrationKey);
        const hasExplicitPreference = readStorage(explicitPreferenceKey) === "1";
        const shouldMigrateLegacyDefault = preferenceMigration
          && storedMigration !== preferenceMigration
          && storedTheme === legacyDefaultTheme
          && !hasExplicitPreference;
        const initialTheme = shouldMigrateLegacyDefault
          ? defaultTheme
          : (isValidTheme(storedTheme) ? storedTheme : defaultTheme);

        if (shouldMigrateLegacyDefault && initialTheme) {
          writeStorage(storageKey, initialTheme);
        }
        if (preferenceMigration && storedMigration !== preferenceMigration) {
          writeStorage(migrationKey, preferenceMigration);
        }

        if (initialTheme) {
          document.documentElement.dataset.theme = initialTheme;
        }

        const setTheme = (theme, { persist = true } = {}) => {
          const nextTheme = isValidTheme(theme) ? theme : defaultTheme;
          if (!nextTheme) {
            return null;
          }

          document.documentElement.dataset.theme = nextTheme;
          if (document.body) {
            document.body.dataset.theme = nextTheme;
          }

          if (persist) {
            writeStorage(storageKey, nextTheme);
            writeStorage(explicitPreferenceKey, "1");
          }

          document.querySelectorAll("[data-theme-nav-link]").forEach((element) => {
            const label = config.navLabels?.[nextTheme];
            if (label) {
              element.textContent = label;
            }
          });

          document.querySelectorAll("[data-theme-current-heading]").forEach((element) => {
            const heading = config.currentHeadings?.[nextTheme];
            if (heading) {
              element.textContent = heading;
            }
          });

          document.querySelectorAll("[data-theme-option]").forEach((element) => {
            const isActive = element.getAttribute("data-theme-option") === nextTheme;
            element.setAttribute("aria-pressed", String(isActive));
            element.classList.toggle("is-active", isActive);
          });

          document.querySelectorAll("[data-theme-sample]").forEach((element) => {
            const isActive = element.getAttribute("data-theme-sample") === nextTheme;
            element.classList.toggle("is-selected", isActive);
          });

          document.querySelectorAll("[data-theme-status]").forEach((element) => {
            const sample = element.closest("[data-theme-sample]");
            element.hidden = sample?.getAttribute("data-theme-sample") !== nextTheme;
          });

          return nextTheme;
        };

        window.rissorTheme = { set: setTheme, get: () => document.documentElement.dataset.theme };

        document.addEventListener("click", (event) => {
          const trigger = event.target instanceof Element ? event.target.closest("[data-theme-option]") : null;
          if (!trigger) {
            return;
          }

          setTheme(trigger.getAttribute("data-theme-option"), { persist: true });
        });

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", () => setTheme(initialTheme, { persist: false }));
        } else {
          setTheme(initialTheme, { persist: false });
        }
      })();
    </script>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__inner">
          <a class="brand" href={localizedPath(locale, "/")} aria-label={siteTitle}>
            <img
              class="brand__logo"
              src={rtLogo.src}
              alt=""
              width="225"
              height="47"
            />
          </a>
          <div class="site-header__controls">
            <nav class="navbar">
    <div class="nav-item dropdown">
        <a
          href={localizedPath(locale, "/books/")}
          class="nav-link"
          aria-current={currentPath.startsWith(localizedPath(locale, "/books/")) ? "page" : undefined}
        >
            {text.nav.books}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 4.687 7.875" class="nav-caret" aria-hidden="true" >
            <path d="M635.621,375.374a0.7,0.7,0,0,0-.147.017,1.31,1.31,0,0,0-.14.041,0.625,0.625,0,0,0-.129.065,0.7,0.7,0,0,0-.123.1l-3.176,3.176a0.932,0.932,0,0,0-.164.252,0.7,0.7,0,0,0-.059.281,0.737,0.737,0,0,0,.059.287,0.767,0.767,0,0,0,.164.247l3.176,3.175a0.734,0.734,0,0,0,.252.17,0.763,0.763,0,0,0,.281.053,0.819,0.819,0,0,0,.287-0.053,0.617,0.617,0,0,0,.246-0.17,0.752,0.752,0,0,0,.164-0.246,0.7,0.7,0,0,0,0-.562,0.752,0.752,0,0,0-.164-0.246l-2.648-2.649,2.648-2.66a0.752,0.752,0,0,0,.164-0.246,0.7,0.7,0,0,0,0-.563,0.774,0.774,0,0,0-.164-0.246,0.855,0.855,0,0,0-.117-0.1,0.488,0.488,0,0,0-.129-0.065c-0.047-.015-0.094-.029-0.141-0.041a0.609,0.609,0,0,0-.14-0.017h0Z"
            transform="translate(-631.688 -375.375)"></path></svg>
        </a>

        <div class="dropdown-menu" aria-label={text.nav.books}>
          {bookNavigationSections.map((section) => (
            <section class="dropdown-language-section" aria-labelledby={`nav-${section.id}-heading`}>
              <a
                class="dropdown-language-section__heading"
                id={`nav-${section.id}-heading`}
                href={`${localizedPath(locale, "/books/")}#${section.id}`}
              >
                {section.label}
              </a>
              {section.shelves.map((group) => (
            <div class="dropdown-group">
              <a
                class="dropdown-group__trigger"
                href={`${localizedPath(locale, "/books/")}#${group.id}`}
                aria-haspopup="true"
              >
                <strong>{group.label}</strong>
                <span aria-hidden="true">›</span>
              </a>
              <div class="dropdown-submenu" aria-label={group.label}>
                {group.books.map((book) => (
                  <a href={localizedPath(locale, `/books/${book.slug}/`)}>
                    <strong>{book.title}</strong>
                  </a>
                ))}
              </div>
            </div>
              ))}
            </section>
          ))}
        </div>
    </div>

    {navigationItems.filter((item) => item.id !== "books").map((item) => (
      <div class="nav-item">
        <a
          href={item.href}
          class="nav-link"
          aria-current={item.isCurrent ? "page" : undefined}
        >
          <span>{navLabels[item.id]}</span>
        </a>
      </div>
    ))}
</nav>
            {resolvedGlobalSearch ? (
              <div
                class="home-search-host"
                data-home-search-host
                data-locale={locale}
                data-manifest-url={resolvedGlobalSearch.manifestUrl}
                data-books={JSON.stringify(resolvedGlobalSearch.books)}
              >
                <button
                  class="home-search__trigger"
                  type="button"
                  aria-expanded="false"
                  aria-controls="global-search-panel"
                  data-global-search-trigger
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
                    <path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
                  </svg>
                  <span>{text.search.triggers.global}</span>
                </button>
              </div>
            ) : null}
            <a class="language-nav-control" href={alternateLocaleHref} hreflang={alternateLocale} lang={alternateLocale} data-locale-preference={alternateLocale}>
              {alternateLocaleLabel}
            </a>
            <details class="site-menu" data-site-menu>
              <summary class="site-menu__toggle" data-site-menu-trigger>
                <span>{text.layout.menu}</span>
                <span class="site-menu__icon" aria-hidden="true"><i></i><i></i><i></i></span>
              </summary>
              <div class="site-menu__panel">
                <nav class="site-menu__links" aria-label={text.layout.primaryNavigation}>
                  {compactNavigationItems.map((item) => (
                    <a href={item.href} aria-current={item.isCurrent ? "page" : undefined}>
                      <span aria-hidden="true">→</span>
                      <span>{item.label}</span>
                    </a>
                  ))}
                </nav>
                <a class="site-menu__contact" href="mailto:risaletedris@gmail.com?subject=RisaleTedris%20ileti%C5%9Fim">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3.5 5.5h17v13h-17z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"></path>
                    <path d="m4.25 6.25 7.75 6 7.75-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
                  </svg>
                  <span>{text.layout.contactAction}</span>
                </a>
                <a class="site-menu__language-link" href={alternateLocaleHref} hreflang={alternateLocale} lang={alternateLocale} data-locale-preference={alternateLocale}>
                  {alternateLocaleLabel}
                </a>
              </div>
            </details>
          </div>
        </div>
      </header>
      <main>
        <slot />
      </main>
    </div>
    <footer class="site-footer site-contact-bar" aria-label={text.layout.contactAriaLabel}>
      <div class="site-footer__inner site-contact-bar__inner">
        <div class="site-contact-bar__message">
          <span class="site-contact-bar__eyebrow">{text.layout.contactEyebrow}</span>
          <strong>{text.layout.contactHeading}</strong>
        </div>
        <a class="site-contact-bar__link" href="mailto:risaletedris@gmail.com?subject=RisaleTedris%20ileti%C5%9Fim">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3.5 5.5h17v13h-17z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"></path>
            <path d="m4.25 6.25 7.75 6 7.75-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
          </svg>
          <span>{text.layout.contactAction}</span>
        </a>
      </div>
    </footer>
    <script>
      import "@/features/search/mountHomeSearch.jsx";
    </script>
    <script>
      const siteMenus = Array.from(document.querySelectorAll("[data-site-menu]"));
      document.addEventListener("rissor:search-open", () => {
        siteMenus.forEach((menu) => menu.removeAttribute("open"));
      });
      siteMenus.forEach((menu) => {
        menu.addEventListener("toggle", () => {
          if (menu.hasAttribute("open")) {
            document.dispatchEvent(new CustomEvent("rissor:menu-open"));
          }
        });
      });
    </script>
  </body>
</html>
