---
import kulliyatImage from "../../assets/home/rnk-kulliyat.png";
import { getHomepageCtas } from "@/features/library/libraryHome.js";
import { getUi, type Locale } from "@/i18n";
import { localizedPath } from "@/i18n/routing";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { locale } = Astro.props as { locale: Locale };
const text = getUi(locale);
const homeCtas = getHomepageCtas();
---

<BaseLayout title={text.home.pageTitle} description={text.home.description} locale={locale}>
  <section class="home-hero">
    <div class="page-band__inner home-hero__inner">
      <div class="home-hero__copy">
        <p class="eyebrow">{text.home.hero.eyebrow}</p>
        <h1>{text.home.hero.heading}</h1>
        {text.home.hero.lede ? <p class="lede">{text.home.hero.lede}</p> : null}
        <ul class="home-hero__feature-labels" aria-label={text.home.hero.lede || text.home.hero.heading}>
          {text.home.hero.featureLabels.map((label) => (
            <li>{label}</li>
          ))}
        </ul>
        <div class="home-actions">
          <a class="button" href={localizedPath(locale, homeCtas.howItWorksHref)}>{text.home.hero.primaryCta}</a>
          <a class="button-secondary" href={localizedPath(locale, homeCtas.lessonFlowHref)}>{text.home.hero.secondaryCta}</a>
        </div>
      </div>

      <div class="home-hero__books" aria-hidden="true">
        <img
          src={kulliyatImage.src}
          width={kulliyatImage.width}
          height={kulliyatImage.height}
          alt=""
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>
</BaseLayout>
