---
import { getUi, type Locale } from "@/i18n";
import { getGradeShortLabel } from "@/i18n/libraryLabels";
import { localizedPath } from "@/i18n/routing";
import { AUGMENTATION_ENABLED, SEARCH_ENABLED } from "@/config/features.js";
import { AugmentationLauncher, PersonalAugmentationList } from "@/features/augmentation/AugmentationIslands.jsx";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { LibraryBook, LibrarySearchBookReference } from "@/types/library";

type Props = {
  book: LibraryBook;
  searchReference: LibrarySearchBookReference;
  availableBookSlugs: string[];
  locale: Locale;
};

const { book, searchReference, availableBookSlugs, locale } = Astro.props as Props;
const text = getUi(locale);
---

<BaseLayout title={book.title} description={text.book.description({ title: book.title })} locale={locale}>
  <section class="page-band">
    <div class="page-band__inner">
      <nav class="breadcrumb" aria-label={text.common.breadcrumb}>
        <a href={localizedPath(locale, "/books/")}>{text.nav.books}</a>
        <span>/</span>
        <span>{book.title}</span>
      </nav>
      <div class="page-title">
        <p class="eyebrow">{text.book.eyebrow}</p>
        <h1>{book.title}</h1>
        <p class="lede">{text.book.lede({ partCount: book.parts.length, gradeCount: book.grades.length })}</p>
      </div>
      <nav class="part-quick-nav book-quick-nav" aria-label={text.book.quickNavigation}>
        <a class="part-quick-nav__button part-quick-nav__button--step book-quick-nav__search" href="#book-search" title={text.search.triggers.book} aria-label={text.search.triggers.book} data-book-search-quick-trigger>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
            <path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
          </svg>
          <span class="part-quick-nav__step-text"><span class="part-quick-nav__step-target">{text.search.triggers.book}</span></span>
        </a>
        <a class="part-quick-nav__button" href="#book-guide" title={text.book.quickNavGuide} aria-label={text.book.quickNavGuide}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 4.5h9.5l2.5 2.5v12.5H6zM9 11h6m-6 3.5h6m-6 3.5h4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
          </svg>
        </a>
        <a class="part-quick-nav__button" href="#book-augmentation" title={text.book.quickNavAugmentation} aria-label={text.book.quickNavAugmentation}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 5v14m-7-7h14" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
          </svg>
        </a>
        <a class="part-quick-nav__button" href="#book-parts" title={text.book.quickNavParts} aria-label={text.book.quickNavParts}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 5h11M7 12h11M7 19h11M4 5h.01M4 12h.01M4 19h.01" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
          </svg>
        </a>
      </nav>

      <section
        id="book-search"
        class="book-search-host"
        data-book-search-host={SEARCH_ENABLED ? "" : undefined}
        data-locale={locale}
        data-book={JSON.stringify(searchReference)}
        data-grades={JSON.stringify(book.grades)}
        data-available-book-slugs={JSON.stringify(availableBookSlugs)}
        data-global-search-url={localizedPath(locale, "/")}
      >
        <details class="book-search-fallback" data-book-search-fallback>
          <summary data-book-search-trigger>{text.search.triggers.book}</summary>
          <div
            class="toolbar"
            data-part-toolbar
            data-search-fallback="metadata"
            data-full-text-search-enabled={String(SEARCH_ENABLED)}
          >
            <div class="field">
              <label for="part-search">{text.book.searchLabel}</label>
              <input id="part-search" type="search" placeholder={text.book.searchPlaceholder} data-part-search />
            </div>
            <div class="field">
              <label for="grade-filter">{text.book.gradeLabel}</label>
              <select id="grade-filter" data-grade-filter>
                <option value="">{text.book.allGrades}</option>
                {book.grades.map((grade) => (
                  <option value={grade.slug}>{getGradeShortLabel(locale, grade.slug, grade.label)}</option>
                ))}
              </select>
            </div>
          </div>
        </details>
      </section>
    </div>
  </section>

  <section class="page-band page-band--muted">
    <div class="page-band__inner">
      <details class="guidance-panel part-workflow book-disclosure" id="book-guide">
        <summary>
          <span class="part-workflow__heading" role="heading" aria-level="2">{text.book.guide.heading}</span>
          <span class="part-workflow__toggle" aria-hidden="true">⌄</span>
        </summary>
        <p>{text.book.guide.body}</p>
      </details>

      {AUGMENTATION_ENABLED ? (
        <details class="guidance-panel part-workflow book-disclosure" id="book-augmentation">
          <summary>
            <span class="part-workflow__heading" role="heading" aria-level="2">{text.book.augmentationHeading}</span>
            <span class="part-workflow__toggle" aria-hidden="true">⌄</span>
          </summary>
          <div class="book-augmentation-tools">
          <section class="guidance-panel augmentation-entry" aria-label={text.augmentation.launch}>
            <AugmentationLauncher
              client:load
              bookSlug={book.slug}
              locale={locale}
              labels={text.augmentation}
              gradeLabels={Object.fromEntries(book.grades.map((grade) => [grade.slug, getGradeShortLabel(locale, grade.slug, grade.label)]))}
            />
          </section>
          <PersonalAugmentationList
            client:load
            bookSlug={book.slug}
            locale={locale}
            labels={text.augmentation}
          />
          </div>
        </details>
      ) : null}

      <details class="guidance-panel part-workflow book-disclosure" id="book-parts">
        <summary>
          <span class="part-workflow__heading" role="heading" aria-level="2">{text.book.partsHeading}</span>
          <span class="part-workflow__toggle" aria-hidden="true">⌄</span>
        </summary>
        <p
          class="filter-status"
          data-filter-status
          data-count-one={text.book.resultCount({ count: 1 }).replace("1", "{count}")}
          data-count-many={text.book.resultCount({ count: 2 }).replace("2", "{count}")}
          aria-live="polite"
        >
          {text.book.resultCount({ count: book.parts.length })}
        </p>
        <div class="part-list" data-part-list>
        {book.parts.map((part) => {
          const gradeSlugs = Object.keys(part.downloads).join(" ");
          const partPath = `/books/${book.slug}/parts/${part.partNo}/`;

          return (
            <article
              class="part-row"
              data-part-row
              data-part-no={part.partNo}
              data-search={`${part.partNo} ${part.title} ${part.labelSlug}`}
              data-grades={gradeSlugs}
            >
              <div class="part-row__number">{part.partNo.toUpperCase()}</div>
              <div class="part-row__body">
                <a class="part-row__title" href={localizedPath(locale, partPath)}>
                  {part.title}
                </a>
                <div class="part-row__excerpt" data-search-excerpt hidden></div>
              </div>
            </article>
          );
        })}
        </div>
        <div class="empty-state" data-filter-empty hidden>{text.book.noResults}</div>
      </details>
    </div>
  </section>

  <script>
    import "@/features/search/mountBookSearch.jsx";
  </script>
  <script>
    document.querySelectorAll(".book-quick-nav a[href^='#']").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        const selector = trigger.getAttribute("href");
        if (!selector) return;
        const target = document.querySelector(selector);
        if (!target) return;
        if (target.id === "book-search") {
          event.preventDefault();
          target.querySelector("[data-book-search-trigger]")?.dispatchEvent(new MouseEvent("click", { bubbles: true }));
          requestAnimationFrame(() => trigger.scrollIntoView({ block: "start" }));
          return;
        }
        if (target instanceof HTMLDetailsElement) {
          target.open = true;
          return;
        }
        target.querySelector("details")?.setAttribute("open", "");
      });
    });
  </script>
</BaseLayout>
