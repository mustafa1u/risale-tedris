---
import { groupBooksByLanguage } from "@/config/bookGroups";
import { librarySummary } from "@/data/library-summary.generated";
import { getUi, type Locale } from "@/i18n";
import { localizedPath } from "@/i18n/routing";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { locale } = Astro.props as { locale: Locale };
const text = getUi(locale);
const bookSections = groupBooksByLanguage(librarySummary.books, locale);
const previousBooksLabel = locale === "tr" ? "Önceki kitaplar" : "Previous books";
const nextBooksLabel = locale === "tr" ? "Sonraki kitaplar" : "Next books";
---

<BaseLayout title={text.library.pageTitle} description={text.library.lede} locale={locale}>
  <section class="page-band library-page">
    <div class="page-band__inner">
      <header class="page-title library-page__intro">
        <p class="eyebrow">{text.library.eyebrow}</p>
        <h1>{text.library.heading}</h1>
        <p class="lede">{text.library.lede}</p>
      </header>

      {librarySummary.books.length === 0 ? (
        <div class="empty-state">
          {text.library.emptyManifestPrefix} <code>npm run manifest:generate</code> {text.library.emptyManifestSuffix}
        </div>
      ) : (
        <div class="book-shelves">
          {bookSections.map((section) => {
            const sectionContentId = `${section.id}-content`;
            return (
              <section
                class="book-language-section"
                id={section.id}
                aria-labelledby={`${section.id}-heading`}
                data-book-language-section
                data-section-id={section.id}
              >
                <button
                  class="book-language-section__toggle"
                  type="button"
                  aria-expanded="false"
                  aria-controls={sectionContentId}
                  data-book-language-toggle
                >
                  <span class="book-language-section__title" id={`${section.id}-heading`}>{section.label}</span>
                  <span class="book-language-section__arrow" aria-hidden="true">›</span>
                </button>
                <div class="book-language-section__content" id={sectionContentId} data-book-language-content hidden>
                  {section.shelves.map((group) => (
                    <section class="book-shelf" id={group.id} aria-labelledby={`${group.id}-heading`} data-book-shelf>
                      <header class="book-shelf__header">
                        <h3 id={`${group.id}-heading`}>{group.label}</h3>
                        <div class="book-shelf__controls" aria-label={group.label}>
                          <button type="button" data-book-shelf-previous aria-label={previousBooksLabel}>←</button>
                          <button type="button" data-book-shelf-next aria-label={nextBooksLabel}>→</button>
                        </div>
                      </header>
                      <div class="book-shelf__viewport" data-book-shelf-viewport tabindex="0">
                        <div class="book-shelf__track">
                          {group.books.map((book) => (
                            <article class="book-card" data-book-slug={book.slug}>
                              <a
                                class="book-card__cover"
                                href={localizedPath(locale, `/books/${book.slug}/`)}
                                aria-label={`${book.title}: ${text.actions.open}`}
                              >
                                <span class="book-card__ornament" aria-hidden="true">❦</span>
                                <h4 class="book-card__title">{book.title}</h4>
                                <span class="book-card__ornament book-card__ornament--bottom" aria-hidden="true">❦</span>
                              </a>
                            </article>
                          ))}
                        </div>
                      </div>
                    </section>
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const sectionStorageKey = "rissor-books-language-sections-v1";
  const languageSections = Array.from(document.querySelectorAll("[data-book-language-section]"));
  let savedSectionState: Record<string, boolean> = {};

  try {
    const saved = localStorage.getItem(sectionStorageKey);
    savedSectionState = saved ? JSON.parse(saved) : {};
  } catch {
    savedSectionState = {};
  }

  const persistSectionState = () => {
    try {
      localStorage.setItem(
        sectionStorageKey,
        JSON.stringify(Object.fromEntries(languageSections.map((section) => [
          section.getAttribute("data-section-id"),
          section.classList.contains("is-expanded")
        ])))
      );
    } catch {
      // Persistence is optional for local/dev previews.
    }
  };

  languageSections.forEach((section) => {
    const toggle = section.querySelector("[data-book-language-toggle]");
    const content = section.querySelector("[data-book-language-content]");
    const sectionId = section.getAttribute("data-section-id");
    if (!(toggle instanceof HTMLButtonElement) || !(content instanceof HTMLElement) || !sectionId) {
      return;
    }

    const setExpanded = (expanded: boolean) => {
      section.classList.toggle("is-expanded", expanded);
      toggle.setAttribute("aria-expanded", String(expanded));
      content.hidden = !expanded;
    };

    const hashTarget = window.location.hash.slice(1);
    const containsHashTarget = hashTarget !== "" && section.contains(document.getElementById(hashTarget));
    setExpanded(savedSectionState[sectionId] === true || hashTarget === sectionId || containsHashTarget);
    toggle.addEventListener("click", () => {
      setExpanded(!section.classList.contains("is-expanded"));
      persistSectionState();
    });
  });

  document.querySelectorAll("[data-book-shelf]").forEach((shelf) => {
    const viewport = shelf.querySelector("[data-book-shelf-viewport]");
    if (!(viewport instanceof HTMLElement)) {
      return;
    }

    const scroll = (direction: number) => {
      viewport.scrollBy({
        left: direction * Math.max(viewport.clientWidth * 0.82, 280),
        behavior: "smooth"
      });
    };

    shelf.querySelector("[data-book-shelf-previous]")?.addEventListener("click", () => scroll(-1));
    shelf.querySelector("[data-book-shelf-next]")?.addEventListener("click", () => scroll(1));
  });
</script>
