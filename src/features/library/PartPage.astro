---
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { getPartDownloadGroups } from "@/features/library/partDownloads.js";
import { getUi, type Locale } from "@/i18n";
import { getGradeShortLabel } from "@/i18n/libraryLabels";
import { localizedPath } from "@/i18n/routing";
import { splitPartText } from "@/features/library/partText.js";
import { AUGMENTATION_ENABLED } from "@/config/features.js";
import { AugmentationLauncher } from "@/features/augmentation/AugmentationIslands.jsx";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { DocumentType, GradeSlug, LibraryBook, LibraryPart } from "@/types/library";

type Props = {
  book: LibraryBook;
  part: LibraryPart;
  locale: Locale;
};
type DownloadActionKey = "docx" | "pdfNormal" | "pdfMobile";
type DownloadAction = {
  available: boolean;
  href?: string;
  download?: boolean;
};
type PartDownloadMaterial = {
  docType: DocumentType;
  actions: Record<DownloadActionKey | "study", DownloadAction>;
};
type PartDownloadGroup = {
  gradeSlug: GradeSlug;
  materials: PartDownloadMaterial[];
};

const { book, part, locale } = Astro.props as Props;
const text = getUi(locale);
const contentPath = resolve(process.cwd(), part.textSourcePath);
const content = await readFile(contentPath, "utf8");

const contentParagraphs = splitPartText(content);
const downloadGroups = getPartDownloadGroups({ book, part }) as PartDownloadGroup[];
const partIndex = book.parts.findIndex((item) => item.partNo === part.partNo);
const previousPart = partIndex > 0 ? book.parts[partIndex - 1] : undefined;
const nextPart = partIndex >= 0 && partIndex < book.parts.length - 1 ? book.parts[partIndex + 1] : undefined;
const partNavigationTitle = (candidate: LibraryPart) => {
  const title = candidate.title.trim();
  if (title.length <= 25) {
    return `${candidate.partNo.toUpperCase()} - ${title}`;
  }
  const cutAt = title.lastIndexOf(" ", 25);
  const shortened = title.slice(0, cutAt > 0 ? cutAt : 25).trimEnd();
  return `${candidate.partNo.toUpperCase()} - ${shortened}`;
};
const adjacentParts = [
  { direction: "previous", label: text.part.previous, arrow: "←", part: previousPart },
  { direction: "next", label: text.part.next, arrow: "→", part: nextPart }
] as const;
const downloadActionLabels = {
  docx: text.downloads.docx,
  pdfNormal: text.downloads.pdf,
  pdfMobile: text.downloads.mobilePdf
};
const downloadActionKeys = Object.keys(downloadActionLabels) as DownloadActionKey[];
const getMaterialHint = (docType: string) =>
  docType === "BK" ? text.downloads.studyHint : text.downloads.questionSheetHint;
const augmentationGradeLabels = Object.fromEntries(
  book.grades.map((grade) => [grade.slug, getGradeShortLabel(locale, grade.slug, grade.label)])
);
---

<BaseLayout
  title={`${part.partNo.toUpperCase()} ${part.title}`}
  description={text.part.description({ partTitle: part.title, bookTitle: book.title })}
  locale={locale}
>
  <section class="page-band">
    <div class="page-band__inner">
      <nav class="breadcrumb" aria-label={text.common.breadcrumb}>
        <a href={localizedPath(locale, "/books/")}>{text.nav.books}</a>
        <span>/</span>
        <a href={localizedPath(locale, `/books/${book.slug}/`)}>{book.title}</a>
        <span>/</span>
        <span>{part.partNo.toUpperCase()}</span>
      </nav>
      <div class="page-title">
        <p class="eyebrow">{text.part.eyebrow({ partNo: part.partNo.toUpperCase() })}</p>
        <h1>{part.title}</h1>
      </div>
      <nav class="part-quick-nav" aria-label={text.part.quickNavigation}>
        <span class="part-quick-nav__jump-group">
          <a class="part-quick-nav__button" href="#part-downloads" title={text.part.quickNavDownloads} aria-label={text.part.quickNavDownloads}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
            </svg>
          </a>
          <a class="part-quick-nav__button" href="#part-text" title={text.part.quickNavText} aria-label={text.part.quickNavText}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 4.5h9.5l2.5 2.5v12.5H6zM9 11h6m-6 3.5h6m-6 3.5h4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
            </svg>
          </a>
        </span>
        <span class="part-quick-nav__step-group" aria-label={text.part.navigationLabel}>
          {adjacentParts.map((item) => {
            const targetPart = item.part;
            const fullLabel = targetPart
              ? `${item.label}: ${targetPart.partNo.toUpperCase()} - ${targetPart.title}`
              : item.label;

            return targetPart ? (
              <a
                class="part-quick-nav__button part-quick-nav__button--step"
                href={localizedPath(locale, `/books/${book.slug}/parts/${targetPart.partNo}/`)}
                title={fullLabel}
                aria-label={fullLabel}
              >
                <span class="part-quick-nav__arrow" aria-hidden="true">{item.arrow}</span>
                <span class="part-quick-nav__step-text">
                  <span class="part-quick-nav__step-label">{item.label}:</span>
                  <span class="part-quick-nav__step-target">{partNavigationTitle(targetPart)}</span>
                </span>
              </a>
            ) : (
              <span class="part-quick-nav__button part-quick-nav__button--step is-disabled" aria-disabled="true">
                <span class="part-quick-nav__arrow" aria-hidden="true">{item.arrow}</span>
                <span class="part-quick-nav__step-text"><span class="part-quick-nav__step-label">{item.label}</span></span>
              </span>
            );
          })}
        </span>
      </nav>
    </div>
  </section>

  <section class="page-band page-band--muted">
    <div class="page-band__inner">
      <div class="part-layout">
        <div class="part-reader">
          {AUGMENTATION_ENABLED ? (
            <section class="guidance-panel augmentation-entry" aria-label={text.augmentation.launch}>
              <AugmentationLauncher
                client:load
                bookSlug={book.slug}
                partNo={part.partNo}
                locale={locale}
                labels={text.augmentation}
                gradeLabels={augmentationGradeLabels}
              />
            </section>
          ) : null}

          <details class="guidance-panel part-workflow">
            <summary>
              <span class="part-workflow__heading" role="heading" aria-level="2">{text.part.workflow.heading}</span>
              <span class="part-workflow__toggle" aria-hidden="true">⌄</span>
            </summary>
            <ol class="compact-steps">
              {text.part.workflow.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          </details>

          <details class="part-text-disclosure" id="part-text">
            <summary>
              <span class="part-text-disclosure__heading" role="heading" aria-level="2">{text.part.textToggle}</span>
              <span class="part-text-disclosure__toggle" aria-hidden="true">⌄</span>
            </summary>
            <div class="part-text">
              {contentParagraphs.map((paragraph) => (
                <p class={`part-paragraph part-paragraph--${paragraph.alignment}`}>
                  {paragraph.segments.map((segment) => (
                    <span class={`part-script part-script--${segment.script}`}>{segment.value}</span>
                  ))}
                </p>
              ))}
            </div>
          </details>

        </div>

        <aside class="download-panel" id="part-downloads" aria-label={text.downloads.label}>
          <details class="download-panel__disclosure" open>
            <summary>
              <span class="download-panel__heading" role="heading" aria-level="2">{text.downloads.heading}</span>
              <span class="download-panel__toggle" aria-hidden="true">⌄</span>
            </summary>
            <div class="download-panel__content">
              <p class="download-panel__note">{text.downloads.mixedAgeGuidance}</p>
              <p class="download-panel__note">{text.downloads.questionSheetNote}</p>
          {downloadGroups.map((group) => {
            const gradeSlug = group.gradeSlug;
            const grade = book.grades.find((item) => item.slug === gradeSlug);
            const gradeLabel = getGradeShortLabel(locale, gradeSlug, grade?.label);

            return (
              <details class="download-group">
                <summary
                  class="download-group__summary"
                  aria-label={text.downloads.openGrade({ gradeLabel })}
                >
                  <span class="download-group__summary-label">{text.downloads.gradeSummary({ gradeLabel })}</span>
                  <span class="download-group__summary-arrow" aria-hidden="true">›</span>
                </summary>

                <div class="download-group__content">
                  {group.materials.map((material) => (
                    <section class="download-material">
                      <header class="download-material__head">
                        <div class="part-row__meta">{text.downloads.variants[material.docType]}</div>
                        <p>{getMaterialHint(material.docType)}</p>
                      </header>

                      {material.docType === "BK" && material.actions.study.available && material.actions.study.href ? (
                        <div class="download-study-action">
                          <a class="button" href={localizedPath(locale, material.actions.study.href)}>
                            {text.study.start}
                          </a>
                        </div>
                      ) : null}

                      <div class="download-grid">
                        {downloadActionKeys.map((actionKey) => {
                          const label = downloadActionLabels[actionKey];
                          const action = material.actions[actionKey];

                          return action.available ? (
                            <a class="button-secondary" href={action.href} download>
                              {label}
                            </a>
                          ) : (
                            <span class="button-muted">{label}</span>
                          );
                        })}
                      </div>
                    </section>
                  ))}
                </div>
              </details>
            );
              })}
            </div>
          </details>
        </aside>
      </div>
    </div>
  </section>

  <script>
    if (window.matchMedia("(max-width: 860px)").matches) {
      document.querySelectorAll(".download-panel__disclosure")
        .forEach((panel) => panel.removeAttribute("open"));
    }

    document.querySelectorAll(".part-quick-nav__button[href^='#']").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const selector = trigger.getAttribute("href");
        if (!selector) {
          return;
        }
        const target = document.querySelector(selector);
        target?.querySelector("details")?.setAttribute("open", "");
        if (target instanceof HTMLDetailsElement) {
          target.open = true;
        }
      });
    });
  </script>
</BaseLayout>
